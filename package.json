{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Uma aplicação de um portfólio pessoal com blog desenvolvida com Next.js e MDX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriveltondasilva/portfolio.git"
  },
  "author": "Erivelton Silva <eriveltondasilva13@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "bun run --bun next build",
    "build:blog": "bun run scripts/generate-blog-index.ts",
    "build:indexes": "bun run build:blog && bun run build:projects && bun run build:schemas",
    "build:projects": "bun run scripts/generate-projects-index.ts",
    "build:schemas": "bun run scripts/generate-zod-schemas.ts",
    "dev": "bun run --bun next dev",
    "fix": "bun run typecheck && bun run lint && bun run fmt",
    "fmt": "bunx prettier . --write --cache",
    "fmt:check": "bunx prettier . --check",
    "knip": "bunx knip",
    "lint": "bunx eslint . --fix --cache",
    "lint:check": "bunx eslint .",
    "new-post": "bun run scripts/generate-new-post.ts",
    "prebuild": "bun run build:blog && bun run build:projects",
    "prepare": "husky",
    "start": "bun run --bun next start",
    "typecheck": "tsc --noEmit",
    "typegen": "bun run --bun next typegen"
  },
  "keywords": [
    "portfolio",
    "nextjs",
    "mdx"
  ],
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.5",
    "@next/third-parties": "^16.4.5",
    "@shikijs/transformers": "^4.6.0",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tweet": "^3.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-mdx-import-media": "^1.4.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.4",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-package": "^2.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-yaml": "^1.3.1",
    "reading-time": "^1.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
