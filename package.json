{
  "name": "portfolio",
  "description": "Uma aplicação de um portfólio pessoal com blog desenvolvida com Next.js e MDX.",
  "author": "Erivelton Silva <eriveltondasilva13@gmail.com>",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriveltondasilva/portfolio.git"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "reactjs",
    "portfolio"
  ],
  "scripts": {
    "start": "bun run --bun next start",
    "dev": "bun run --bun next dev",
    "predev": "bun run build:indexes && bun run build:schemas",
    "build": "bun run --bun next build",
    "prebuild": "bun run build:indexes",
    "1xxx": "",
    "build:blog": "bun run scripts/generate-blog-index.ts",
    "build:projects": "bun run scripts/generate-projects-index.ts",
    "build:schemas": "bun run scripts/generate-zod-schemas.ts",
    "build:indexes": "bun run build:blog && bun run build:projects",
    "2xxx": "",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix --cache",
    "fmt": "bunx prettier . --check",
    "fmt:fix": "bunx prettier . --write --cache",
    "3xxx": "",
    "types": "tsc --noEmit",
    "fix": "bun run types && bun run lint:fix && bun run fmt:fix"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@next/third-parties": "^16.4.2",
    "@octokit/rest": "^22.0.1",
    "@types/mdx": "^2.0.14",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tweet": "^3.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-mdx-import-media": "^1.4.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
